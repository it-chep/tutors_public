# При true запросы передают это значение в параметре hostname.
# При false используется домен из адресной строки браузера.
REACT_APP_DEBUG=true
REACT_APP_CLIENT_DOMAIN=example.com

# Адрес backend для dev-сервера React.
BACKEND_URL=http://localhost:8080

# Origin публичного API для production-сборки. Если не задан, используется текущий origin.
REACT_APP_BACKEND_URL=
